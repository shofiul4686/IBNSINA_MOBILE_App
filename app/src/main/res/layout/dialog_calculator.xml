<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_search_rounded"
    android:backgroundTint="#F0F4F8">

    <TextView
        android:id="@+id/tvCalcExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="4dp"
        android:textColor="#546E7A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCalcResult"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/white"
        android:gravity="end|center_vertical"
        android:padding="12dp"
        android:text="0"
        android:textColor="@color/ibnsina_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <GridLayout
        android:id="@+id/gridCalculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <!-- Row 1 -->
        <Button style="@style/CalcBtnStyle" android:text="C" android:textColor="@color/ibnsina_red" />
        <Button style="@style/CalcBtnStyle" android:text="DEL" android:textColor="@color/ibnsina_red" />
        <Button style="@style/CalcBtnStyle" android:text="%" />
        <Button style="@style/CalcBtnStyle" android:text="/" android:textColor="@color/ibnsina_blue" />

        <!-- Row 2 -->
        <Button style="@style/CalcBtnStyle" android:text="7" />
        <Button style="@style/CalcBtnStyle" android:text="8" />
        <Button style="@style/CalcBtnStyle" android:text="9" />
        <Button style="@style/CalcBtnStyle" android:text="*" android:textColor="@color/ibnsina_blue" />

        <!-- Row 3 -->
        <Button style="@style/CalcBtnStyle" android:text="4" />
        <Button style="@style/CalcBtnStyle" android:text="5" />
        <Button style="@style/CalcBtnStyle" android:text="6" />
        <Button style="@style/CalcBtnStyle" android:text="-" android:textColor="@color/ibnsina_blue" />

        <!-- Row 4 -->
        <Button style="@style/CalcBtnStyle" android:text="1" />
        <Button style="@style/CalcBtnStyle" android:text="2" />
        <Button style="@style/CalcBtnStyle" android:text="3" />
        <Button style="@style/CalcBtnStyle" android:text="+" android:textColor="@color/ibnsina_blue" />

        <!-- Row 5 -->
        <Button style="@style/CalcBtnStyle" android:text="0" />
        <Button style="@style/CalcBtnStyle" android:text="00" />
        <Button style="@style/CalcBtnStyle" android:text="." />
        <Button style="@style/CalcBtnStyle" android:text="=" android:backgroundTint="@color/ibnsina_blue" android:textColor="@color/white" />

    </GridLayout>

    <Button
        android:id="@+id/btnCalcClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Close"
        style="@style/Widget.Material3.Button.TextButton"/>

</LinearLayout>
