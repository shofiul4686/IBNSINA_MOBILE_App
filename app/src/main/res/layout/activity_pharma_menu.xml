<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Professional White Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/desc_back"
            app:tint="@color/ibnsina_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/pharma_menu_title"
            android:textColor="@color/ibnsina_blue"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Card: Stock Report Update -->
            <LinearLayout
                android:id="@+id/cardStockReport"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView 
                    android:layout_width="35dp" 
                    android:layout_height="35dp" 
                    android:src="@android:drawable/ic_menu_sort_by_size" 
                    android:contentDescription="@string/desc_menu_icon"
                    app:tint="@color/ibnsina_blue" />
                <TextView 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:layout_weight="1" 
                    android:layout_marginStart="16dp" 
                    android:text="@string/stock_report_update" 
                    android:textColor="@color/ibnsina_blue" 
                    android:textSize="17sp" 
                    android:textStyle="bold" />
                <ImageView 
                    android:layout_width="20dp" 
                    android:layout_height="20dp" 
                    android:src="@android:drawable/ic_media_play" 
                    android:contentDescription="@string/desc_go_icon"
                    app:tint="@color/text_gray" />
            </LinearLayout>

            <!-- Card: Stock Report Manual -->
            <LinearLayout
                android:id="@+id/cardSalesUpdate"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView 
                    android:layout_width="35dp" 
                    android:layout_height="35dp" 
                    android:src="@android:drawable/ic_menu_edit" 
                    android:contentDescription="@string/desc_menu_icon"
                    app:tint="@color/ibnsina_blue" />
                <TextView 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:layout_weight="1" 
                    android:layout_marginStart="16dp" 
                    android:text="@string/stock_report_manual" 
                    android:textColor="@color/ibnsina_blue" 
                    android:textSize="17sp" 
                    android:textStyle="bold" />
                <ImageView 
                    android:layout_width="20dp" 
                    android:layout_height="20dp" 
                    android:src="@android:drawable/ic_media_play" 
                    android:contentDescription="@string/desc_go_icon"
                    app:tint="@color/text_gray" />
            </LinearLayout>

            <!-- Card: Short Date Tracking -->
            <LinearLayout
                android:id="@+id/cardShortItems"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView 
                    android:layout_width="35dp" 
                    android:layout_height="35dp" 
                    android:src="@android:drawable/ic_dialog_alert" 
                    android:contentDescription="@string/desc_menu_icon"
                    app:tint="@color/ibnsina_red" />
                <TextView 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:layout_weight="1" 
                    android:layout_marginStart="16dp" 
                    android:text="@string/short_date_tracking" 
                    android:textColor="@color/ibnsina_red" 
                    android:textSize="17sp" 
                    android:textStyle="bold" />
                <ImageView 
                    android:layout_width="20dp" 
                    android:layout_height="20dp" 
                    android:src="@android:drawable/ic_media_play" 
                    android:contentDescription="@string/desc_go_icon"
                    app:tint="@color/text_gray" />
            </LinearLayout>

            <!-- Card: Carton QTY Update -->
            <LinearLayout
                android:id="@+id/cardOrderList"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="10dp"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView 
                    android:layout_width="35dp" 
                    android:layout_height="35dp" 
                    android:src="@android:drawable/ic_menu_agenda" 
                    android:contentDescription="@string/desc_menu_icon"
                    app:tint="@color/ibnsina_blue" />
                <TextView 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:layout_weight="1" 
                    android:layout_marginStart="16dp" 
                    android:text="@string/carton_qty_update" 
                    android:textColor="@color/ibnsina_blue" 
                    android:textSize="17sp" 
                    android:textStyle="bold" />
                <ImageView 
                    android:layout_width="20dp" 
                    android:layout_height="20dp" 
                    android:src="@android:drawable/ic_media_play" 
                    android:contentDescription="@string/desc_go_icon"
                    app:tint="@color/text_gray" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>