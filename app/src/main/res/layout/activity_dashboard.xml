<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- White Header - Perfectly Centered Text -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/white"
            android:elevation="4dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerVertical="true"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="The IBN SINA Pharmaceutical Industry PLC"
                    android:textColor="@color/ibnsina_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="DINAJPUR DEPOT"
                    android:textColor="@color/ibnsina_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="15dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- PHARMA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPharma"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/ibnsina_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHARMA" android:textColor="@color/ibnsina_blue" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SINAVISION -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSinaVision"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_menu_view" app:tint="@color/ibnsina_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SINAVISION" android:textColor="@color/ibnsina_blue" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- INM -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardINM"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/ibnsina_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INM" android:textColor="@color/ibnsina_blue" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- DATA UPLOAD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDataUpload"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/stat_sys_upload" app:tint="@color/ibnsina_red" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATA UPLOAD" android:textColor="@color/ibnsina_red" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SETTING -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSetting"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_menu_preferences" app:tint="@color/ibnsina_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETTING" android:textColor="@color/ibnsina_blue" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ABOUT -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAbout"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@android:drawable/ic_menu_info_details" app:tint="@color/ibnsina_blue" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABOUT" android:textColor="@color/ibnsina_blue" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- LOGOUT (Updated to match image) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLogout"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_logout_icon"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_lock_power_off"
                            app:tint="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOGOUT" android:textColor="@color/ibnsina_red" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- User Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="15dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:gravity="center">
                    <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ibnsina_blue" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvUserDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_gray" android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:text="Design by : SHOFIUL ALOM"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:textStyle="italic" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>