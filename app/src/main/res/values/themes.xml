<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IBNSINA" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/ibnsina_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ibnsina_red</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@color/bg_light</item>
        
        <!-- Status Bar: White with dark icons for visibility -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

</resources>